# xboard-node WARP compose settings
API_HOST=https://panel.example.com
API_KEY=your-server-token
NODE_ID=1

# singbox (default) or xray
KERNEL_TYPE=singbox
LOG_LEVEL=info

# WARP egress: off | all | v6
WARP_MODE=all
# Optional WARP+ subscription key
WARP_LICENSE_KEY=
# Optional comma-separated ingress overrides
WARP_ENDPOINT=
