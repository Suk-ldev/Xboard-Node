# xboard-node compose settings
# Panel connection (required — the only credentials that must be set by hand)
API_HOST=https://panel.example.com
API_KEY=your-server-token
NODE_ID=1

# singbox (default) or xray
KERNEL_TYPE=singbox
LOG_LEVEL=info

# ── Egress control panel (recommended) ──
# Web UI for WARP + vpngate management; credentials are generated and logged
# once on first boot (docker logs xboard-node | grep credentials).
ADMIN_PORT=65520

# ── WARP egress (seed only — the panel owns these after first boot) ──
# off | all | v6
WARP_MODE=off
#WARP_LICENSE_KEY=
#WARP_ENDPOINT=

# ── VPNGate residential egress (seed only — the panel owns these) ──
# off | all
VG_MODE=off
#VG_SUB_URL=
#VG_RESIDENTIAL_ONLY=1
#VG_MAX_FRAUD=30
